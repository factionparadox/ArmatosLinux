<?xml version="1.0" encoding="UTF-8"?>
<!-- Socii: catalogue entries for software from Armatos's allied APT
     repositories, which publish no AppStream data of their own. Without
     these, Forum could not list them. -->
<components version="1.0" origin="armatos-socii">
  <component type="desktop-application">
    <id>org.mozilla.firefox</id>
    <pkgname>firefox</pkgname>
    <name>Firefox</name>
    <summary>Web browser by Mozilla</summary>
    <description>
      <p>Firefox from Mozilla's own APT repository: a real .deb, built and supported by Mozilla
      and updated in step with Firefox's own releases. Not Ubuntu's snap shim.</p>
      <p>Language packs are separate packages named firefox-l10n followed by a language code.</p>
    </description>
    <!-- Papirus (installed with the shell) has Firefox's icon; the theme name
         is the fallback if it ever moves. -->
    <icon type="local">/usr/share/icons/Papirus/64x64/apps/firefox.svg</icon>
    <icon type="stock">firefox</icon>
    <launchable type="desktop-id">firefox.desktop</launchable>
    <url type="homepage">https://www.mozilla.org/firefox/</url>
    <url type="help">https://support.mozilla.org/products/firefox</url>
    <url type="bugtracker">https://bugzilla.mozilla.org/</url>
    <url type="donation">https://foundation.mozilla.org/donate/</url>
    <project_license>MPL-2.0</project_license>
    <developer id="org.mozilla">
      <name>Mozilla</name>
    </developer>
    <categories>
      <category>Network</category>
      <category>WebBrowser</category>
    </categories>
    <keywords>
      <keyword>browser</keyword>
      <keyword>web</keyword>
      <keyword>internet</keyword>
      <keyword>mozilla</keyword>
    </keywords>
    <provides>
      <binary>firefox</binary>
    </provides>
  </component>
  <component type="desktop-application">
    <id>proton.vpn.app.gtk</id>
    <pkgname>proton-vpn-gnome-desktop</pkgname>
    <name>Proton VPN</name>
    <summary>Secure VPN by Proton, the makers of Proton Mail</summary>
    <description>
      <p>Proton VPN's official app, from Proton's own APT repository. Swiss-based, no-logs, with
      a kill switch and Secure Core servers. Includes the protonvpn command-line tool.</p>
      <p>The app keeps your sign-in in the system keyring (gnome-keyring).</p>
    </description>
    <icon type="local">/usr/share/icons/Papirus/64x64/apps/proton-vpn-logo.svg</icon>
    <icon type="stock">proton-vpn-logo</icon>
    <launchable type="desktop-id">proton.vpn.app.gtk.desktop</launchable>
    <url type="homepage">https://protonvpn.com/</url>
    <url type="help">https://protonvpn.com/support/</url>
    <url type="vcs-browser">https://github.com/ProtonVPN/proton-vpn-gtk-app</url>
    <project_license>GPL-3.0-or-later</project_license>
    <developer id="com.proton">
      <name>Proton AG</name>
    </developer>
    <categories>
      <category>Network</category>
    </categories>
    <keywords>
      <keyword>vpn</keyword>
      <keyword>proton</keyword>
      <keyword>privacy</keyword>
    </keywords>
    <provides>
      <binary>protonvpn-app</binary>
    </provides>
  </component>
</components>
