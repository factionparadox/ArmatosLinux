#!/bin/sh
# Called by tools/build-debs.sh: copy the generated textures and the Cinzel
# faces into the package. $1 = repo root, $2 = staging tree.
set -e
root=$1 stage=$2
mkdir -p "$stage/usr/share/armatos/shell/assets" "$stage/usr/share/fonts/truetype/cinzel" "$stage/etc/xdg/quickshell"
cp "$root"/art/shell/* "$stage/usr/share/armatos/shell/assets/"
cp "$root"/art/fonts/Cinzel-*.ttf "$root/art/fonts/OFL.txt" "$stage/usr/share/fonts/truetype/cinzel/"
ln -sfn /usr/share/armatos/shell "$stage/etc/xdg/quickshell/armatos"
