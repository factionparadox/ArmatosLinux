#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = abort-install ]; then
	rm -rf /boot/grub/themes/armatos
	for f in 10_linux 30_uefi-firmware; do
		dpkg-divert --package armatos-boot-theme --remove --rename \
			--divert "/usr/share/armatos/grub/$f" "/etc/grub.d/$f" >/dev/null || true
	done
	rmdir /usr/share/armatos/grub 2>/dev/null || true
fi
exit 0
